<UserControl
  x:Class="Dragons.Views.Settings.DisplaySettings"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Dragons.ViewModels"
  mc:Ignorable="d" 
  d:DesignHeight="768"
  d:DesignWidth="346"
  d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    
  <StackPanel Background="{StaticResource SettingsBackgroundBrush}">

    <ToggleSwitch Header="Last move" OnContent="Show" OffContent="Hide" 
      IsOn="{Binding IsLastMoveIndicatorShowing, Mode=TwoWay}"/>

    <ToggleSwitch Header="Valid moves" OnContent="Show" OffContent="Hide" 
      IsOn="{Binding IsShowingValidMoves, Mode=TwoWay}"/>

    <ToggleSwitch Header="Clock" OnContent="Show" OffContent="Hide" 
      IsOn="{Binding IsClockShowing, Mode=TwoWay}"/>

  </StackPanel>

</UserControl>
