<Page
    x:Class="Dragons.Views.GameBoard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dragons.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:common="using:Dragons.Common"
    mc:Ignorable="d">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="../Assets/darkbackground.jpg" Stretch="UniformToFill"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="500*"></RowDefinition>
            <RowDefinition Height="500*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="750*"></ColumnDefinition>
            <ColumnDefinition Width="270*"></ColumnDefinition>
            <ColumnDefinition Width="900*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!--Opponent Board Start-->
        <Viewbox Name="OpponentViewbox" Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10, 10,10,10">
            <local:OpponentBoard x:Name="OpponentBoard"></local:OpponentBoard>
        </Viewbox>

        <!--Opponent Board End-->
        <!--Player Board Start-->
        <Viewbox Name="PlayerViewbox" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10, 10,10,10">
            <Grid x:Name="PlayerBoardGrid"></Grid>
            <!--<local:PlayerBoard x:Name="PlayerBoard" Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" />-->
        </Viewbox>
        <Button Grid.Row="1" Grid.Column="2" BorderThickness="0" HorizontalAlignment="Right" Visibility="Visible" Height="80" Width="80"
                Margin="0,0,0,0" VerticalAlignment="Bottom" Click="OpponentCastButton_Click">
        </Button>
        <Button Grid.Row="1" Grid.Column="0" BorderThickness="0" HorizontalAlignment="Left" Visibility="Visible"
                Margin="0,0,0,0" VerticalAlignment="Bottom" Width="50" Height="50" x:Name="ManaCheat" Click="ManaCheat_OnClick">
        </Button>
        <!--Player Board End-->

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/icons/backbutton.png" Width="220"  />
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <Image Grid.ColumnSpan="2" Source="ms-appx:///Assets/icons/mana.png" />
                <TextBlock Grid.Column="0" x:Name="CurrentManaText" Foreground="Black" 
                           FontSize="31" FontFamily="Assets/fonts/CelticHand.ttf#Celtic Hand" HorizontalAlignment="Right" VerticalAlignment="Center" Text="10" ></TextBlock>
            </Grid>
            <Image x:Name="WizardImage" Grid.ColumnSpan="3" Grid.RowSpan="2" Stretch="Uniform" HorizontalAlignment="Center" 
                   Margin="0,0,0,0" VerticalAlignment="Bottom" Source="ms-appx:///Assets/buttons/wizardwithoutmagic.png"/>

            <Image x:Name="WizardImageCast" Grid.ColumnSpan="3" Grid.RowSpan="2" Stretch="Uniform" HorizontalAlignment="Center" Opacity="0"
                   Margin="0,0,0,0" VerticalAlignment="Bottom" Source="ms-appx:///Assets/buttons/wizardwithmagic.png"/>

            <Image x:Name="WizardImageDead" Grid.ColumnSpan="3" Grid.RowSpan="2" Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Center" 
                   Margin="0,0,0,0" VerticalAlignment="Bottom" Source="ms-appx:///Assets/buttons/wizarddead.png"/>

            <Image x:Name="WizardImageFire" Grid.ColumnSpan="3" Grid.RowSpan="2" Stretch="Uniform" Visibility="Visible" HorizontalAlignment="Center" Opacity="0"
                   Margin="0,0,0,0" VerticalAlignment="Bottom" Source="ms-appx:///Assets/buttons/wizardonfire.png"/>

            <Button x:Name="CastButton" Grid.Row="1" Grid.Column="1" BorderThickness="0" Visibility="Visible" HorizontalAlignment="Center" Margin="0,0,0,0" VerticalAlignment="Bottom" Click="CastButton_Click" Opacity="1">
                <Image Source="ms-appx:///Assets/icons/cast.png" Width="140"/>
            </Button>
            <Button Grid.Row="0" Grid.Column="0" BorderThickness="0" Height="200" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center" Click="QuitButton_OnClick" FontSize="30" FontWeight="Thin" Content="" FontFamily="Assets/fonts/CelticHand.ttf#Celtic Hand" Foreground="NavajoWhite" />
            <TextBlock x:Name="TitleBar" Grid.ColumnSpan="3" Foreground="NavajoWhite" FontWeight="ExtraBold" HorizontalAlignment="Stretch" Margin="0,0,0,0" FontFamily="Assets/fonts/CelticHand.ttf#Celtic Hand" TextAlignment="Center" TextWrapping="NoWrap" Text="Wizard Dude vs Dude Wiz" FontSize="34" VerticalAlignment="Top"/>
        </Grid>
        <!--Wizardry Area End-->
        <!--Spell Area Start-->
        <StackPanel x:Name="SpellButtons" Grid.Column="1" HorizontalAlignment="Stretch" Margin="10,10,10,10" VerticalAlignment="Center" Grid.RowSpan="2" Opacity="0.5" >
            <Button x:Name="RestButton" Click="SpellButton_OnClick" Tag="rest,0" HorizontalAlignment="Center"  VerticalAlignment="Top" BorderThickness="0">
                <Image HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform" Source="ms-appx:///Assets/icons/rest.png"/>
            </Button>
            <Button x:Name="BoltButton" Click="SpellButton_OnClick" Tag="bolt,5" HorizontalAlignment="Center"  VerticalAlignment="Top" BorderThickness="0">
                <Image HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform" Source="ms-appx:///Assets/icons/bolt.png"/>
            </Button>
            <Button x:Name="ExplodeButton" Click="SpellButton_OnClick" Tag="explode,20" HorizontalAlignment="Center"  VerticalAlignment="Top" BorderThickness="0">
                <Image HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform" Source="ms-appx:///Assets/icons/explode.png"/>
            </Button>
            <Button x:Name="VerticalBlastButton" Click="SpellButton_OnClick" Tag="vertical,35" HorizontalAlignment="Center" VerticalAlignment="Top" BorderThickness="0" >
                <Image HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform" Source="ms-appx:///Assets/icons/vertical blast.png"/>
            </Button>
            <Button x:Name="HorizontalBlastButton" Click="SpellButton_OnClick" Tag="horizontal,35" HorizontalAlignment="Center"  VerticalAlignment="Top" BorderThickness="0">
                <Image HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform" Source="ms-appx:///Assets/icons/horizontal blast.png"/>
            </Button>
            <Button x:Name="DragonFuryButton" Click="SpellButton_OnClick" Tag="dragon,60" HorizontalAlignment="Center"  VerticalAlignment="Top" BorderThickness="0">
                <Image HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform" Source="ms-appx:///Assets/icons/dragonfury.png"/>
            </Button>
        </StackPanel>
        <Grid Opacity="0.5"  x:Name="WaitingDisplay" Visibility="Collapsed" Background="DarkSlateGray" Grid.RowSpan="2" Grid.ColumnSpan="3">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" Foreground="NavajoWhite" VerticalAlignment="Center" FontFamily="Assets/fonts/CelticHand.ttf#Celtic Hand" x:Name="WaitingDisplayText" FontSize="50" Text="Finding an opponent ..."/>
                <Button x:Name="WaitingCancelButton" Foreground="NavajoWhite" HorizontalAlignment="Center" FontFamily="Assets/fonts/CelticHand.ttf#Celtic Hand" VerticalAlignment="Center" FontSize="35" Click="WaitingCancelButton_OnClick">Cancel</Button>
            </StackPanel>
        </Grid>
        <Grid Opacity="0.5"  x:Name="WonDisplay" Visibility="Collapsed" Background="DarkSlateGray" Grid.RowSpan="2" Grid.ColumnSpan="3">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" Foreground="NavajoWhite" VerticalAlignment="Center" x:Name="WonDisplayText" FontSize="50" Text="You win!" FontFamily="Assets/fonts/CelticHand.ttf#Celtic Hand"/>
                <Button x:Name="WinExitButton" Click="WinExitButton_OnClick"  Foreground="NavajoWhite" HorizontalAlignment="Center" FontFamily="Assets/fonts/CelticHand.ttf#Celtic Hand" FontSize="30" VerticalAlignment="Center">Exit</Button>
            </StackPanel>
        </Grid>
        <!--Spell Area End-->
        <Grid.Resources>
            <Storyboard x:Name="KillWizard">
                <DoubleAnimationUsingKeyFrames  BeginTime="00:00:00" Duration="00:00:03.0000000" Storyboard.TargetName="WizardImageFire" Storyboard.TargetProperty="(Image.Opacity)">
                    <LinearDoubleKeyFrame Value="1" KeyTime="00:00:01.5000000" />
                    <LinearDoubleKeyFrame Value="0" KeyTime="00:00:01.5000000" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Name="CastSpell">
                <DoubleAnimationUsingKeyFrames  BeginTime="00:00:00" Duration="00:00:01.0000000" Storyboard.TargetName="WizardImageCast" Storyboard.TargetProperty="(Image.Opacity)">
                    <LinearDoubleKeyFrame Value="1" KeyTime="00:00:00.5000000" />
                    <LinearDoubleKeyFrame Value="0" KeyTime="00:00:00.5000000" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <!--<Storyboard x:Name="FireBallHighLight">
                <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="VerticalBlastImage" Storyboard.TargetProperty="(Image.Source)">
                    <DiscreteObjectKeyFrame KeyTime="00:00:00.7000000">
                        <DiscreteObjectKeyFrame.Value>
                            <BitmapImage UriSource="ms-appx:///Assets/icons/horizontal blast.png" />
