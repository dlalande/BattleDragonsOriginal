                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="00:00:01.7000000">
                        <DiscreteObjectKeyFrame.Value>
                            <BitmapImage UriSource="ms-appx:///Assets/icons/vertical blast.png" />
                        </DiscreteObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                </ObjectAnimationUsingKeyFrames>
            </Storyboard>-->
        </Grid.Resources>

    </Grid>
</Page>